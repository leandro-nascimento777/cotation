# Chave da API do Gemini (gratuita) — gere em https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Modelo usado para extrair os dados do print (padrão: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Caminho do python (dentro do venv) usado para gerar o PDF via
# pdf-template/generate_pdf.py — ver pdf-template/README.md para criar o venv.
# Sem essa variável, cai no "python3" do sistema (precisa ter jinja2 e
# weasyprint instalados globalmente).
PDF_PYTHON_BIN=./pdf-template/.venv/bin/python3
