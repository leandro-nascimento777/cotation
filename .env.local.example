# Chave da API do Gemini (gratuita) — gere em https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Modelo usado para extrair os dados do print (padrão: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Postgres (Neon, via Vercel Marketplace) — usado pela proposta pública
# (aba Link). Não preencha à mão: rode `vercel link` + `vercel env pull
# .env.local --yes` nesse projeto pra trazer os valores reais.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob — upload de imagem de capa customizada na proposta pública.
# Também vem via `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
